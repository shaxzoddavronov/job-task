# Optional settings. Copy to `.env` and edit — every one has a sensible
# default, and the app runs correctly with no .env at all.
#
#     cp .env.example .env
#
# Hardware detection is NOT configured here: the launcher measures your GPU
# and the app picks a model to match. Only override HOST_GPU_FREE_MB if you
# want to force a particular tier for testing.

# Host port for the web page. Unset means: use 8000, or the next free port.
#APP_PORT=8000

# Clauses sent to the model per call.
#   1 (default) — most accurate
#   4           — roughly twice as fast on long documents, but measurably less
#                 accurate on real ones (executors 87% -> 83% overall, and
#                 64% -> 51% on the lex.uz documents). See the README.
#CLAUSE_BATCH_SIZE=1

# Pretend the GPU has this much free VRAM, to force a tier:
#   0     -> T0, CPU only
#   6144  -> T1, qwen3:4b
#   12288 -> T2, qwen3:8b
#   24576 -> T3, qwen3:8b-q8_0
# Leave unset for real detection.
#HOST_GPU_FREE_MB=

# Concurrent requests to the model. The launcher sets 4 on GPU and 1 on CPU;
# measurements showed no benefit above 4.
#OLLAMA_NUM_PARALLEL=
