# Telegram. Leave BOT_TOKEN empty to read the token from BOT_TOKEN_FILE instead.
BOT_TOKEN=
BOT_TOKEN_FILE=bot_token.txt
# Local `make bot`; docker compose sets http://api:8000 itself
API_URL=http://localhost:8000
API_PORT=8000

# Compute. DEVICE=auto uses an NVIDIA GPU when available, else CPU.
# RERANKER=auto runs the cross-encoder only on GPU (on CPU it would take seconds per question).
DEVICE=auto
RERANKER=auto
# CPU only: number of threads for PyTorch (empty = all cores)
CPU_THREADS=

# Optional overrides of the calibrated thresholds (empty = defaults in app/core/config.py).
# Higher ANSWER_THRESHOLD_* = fewer but more careful direct answers.
ANSWER_THRESHOLD_RERANK=
SUGGEST_THRESHOLD_RERANK=
ANSWER_THRESHOLD_DENSE=
SUGGEST_THRESHOLD_DENSE=

# Data source for the API: postgres | file (CSV/xlsx in data/)
DATA_SOURCE=file

# PostgreSQL
POSTGRES_USER=qa
POSTGRES_PASSWORD=qa
POSTGRES_DB=qa
POSTGRES_PORT=5440
# Local runs: localhost:5440 (compose db). Inside Docker: db:5432.
DATABASE_URL=postgresql+psycopg://qa:qa@localhost:5440/qa
# DB tests (make test-db) run only when this is set; they use their own database.
# TEST_DATABASE_URL=postgresql+psycopg://qa:qa@localhost:5440/qa_test
