# Telegram. Leave BOT_TOKEN empty to read the token from BOT_TOKEN_FILE instead.
BOT_TOKEN=
BOT_TOKEN_FILE=bot_token.txt
API_URL=http://api:8000

# Confidence thresholds (calibrated in Phase 7; empty = use config defaults)
ANSWER_THRESHOLD=
SUGGEST_THRESHOLD=

# Data source for the API: postgres | xlsx
DATA_SOURCE=xlsx

# PostgreSQL
POSTGRES_USER=qa
POSTGRES_PASSWORD=qa
POSTGRES_DB=qa
DATABASE_URL=postgresql+psycopg://qa:qa@db:5432/qa
